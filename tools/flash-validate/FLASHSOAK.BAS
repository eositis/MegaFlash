5 REM FLASHSOAK - overnight validation loop with CSV logging
6 REM WARNING: destructive test; formats and rewrites writable volumes
10 HOME : PRINT "MEGAFLASH FLASHSOAK"
20 INPUT "SLOT (1-7, default 4)";SL: IF SL < 1 THEN SL = 4
30 IF SL > 7 THEN SL = 4
40 CR = 49280 + 16 * SL: PX = CR + 1: D1 = CR + 2
50 D$ = CHR$(4): HK$ = "192.168.0.10"
60 INPUT "LOG FILE (default SOAK.CSV)";LG$: IF LG$ = "" THEN LG$ = "SOAK.CSV"
70 PRINT "SLOT ";SL;" BASE ";CR
80 PRINT "SERVER ";HK$
90 GOSUB 300: QC = 3: GOSUB 400
100 GOSUB 9000
110 CY = 1
120 PRINT "RUNNING... CTRL-RESET TO STOP"
130 GOSUB 1000
140 CY = CY + 1
150 GOTO 130

200 REM ----- CS += V (16-bit) -----
210 CS = CS + V: IF CS >= 65536 THEN CS = CS - 65536
220 RETURN

300 REM ----- CMD 0 RESET POINTERS -----
310 POKE CR,0: GOSUB 500
320 RETURN

400 REM ----- EXEC QC -----
410 POKE CR,QC: GOSUB 500
420 RETURN

500 REM ----- WAIT NOT BUSY -----
510 IF PEEK(CR) > 127 THEN 510
520 RETURN

600 REM ----- BN -> LO,MI,HI -----
610 LO = BN - INT(BN / 256) * 256
620 MI = INT(BN / 256) - INT(BN / 65536) * 256
630 HI = INT(BN / 65536)
640 RETURN

1000 REM ===== ONE CYCLE =====
1010 AU = 1
1020 GOSUB 1500: UC = BC
1030 GOSUB 9500: EV$ = "CYCLE_START": RS$ = "OK": V1 = UC: V2 = 0: GOSUB 9200
1040 AP = 1
1050 FOR U = 1 TO UC
1060 GOSUB 1500
1070 IF BC < 32 THEN GOSUB 9600: EV$ = "UNIT_SKIP": RS$ = "SMALL": V1 = BC: V2 = 0: GOSUB 9200: GOTO 1290
1080 US$ = MID$(STR$(U),2): VN$ = "VAL" + US$: FN$ = "validation" + US$ + ".po"
1090 GOSUB 9600: EV$ = "UNIT_START": RS$ = "OK": V1 = BC: V2 = 0: GOSUB 9200
1100 GOSUB 2000
1110 IF RE <> 0 THEN AP = 0: EV$ = "FORMAT_A": RS$ = "FAIL": V1 = RE: V2 = ME: GOSUB 9200: GOTO 1290
1120 EV$ = "FORMAT_A": RS$ = "OK": V1 = 0: V2 = 0: GOSUB 9200
1130 GOSUB 3000
1140 IF FE <> 0 THEN AP = 0: EV$ = "FILES": RS$ = "FAIL": V1 = FE: V2 = 0: GOSUB 9200: GOTO 1290
1150 EV$ = "FILES": RS$ = "OK": V1 = 0: V2 = 0: GOSUB 9200
1160 GOSUB 4000: C1 = CS
1170 EV$ = "CHK_A": RS$ = "OK": V1 = C1: V2 = 0: GOSUB 9200
1180 DI = 1: GOSUB 5000
1190 IF TE <> 0 THEN AP = 0: EV$ = "TFTP_UP": RS$ = "FAIL": V1 = TE: V2 = TS: GOSUB 9200: GOTO 1290
1200 EV$ = "TFTP_UP": RS$ = "OK": V1 = 0: V2 = 0: GOSUB 9200
1210 GOSUB 2000
1220 IF RE <> 0 THEN AP = 0: EV$ = "FORMAT_B": RS$ = "FAIL": V1 = RE: V2 = ME: GOSUB 9200: GOTO 1290
1230 EV$ = "FORMAT_B": RS$ = "OK": V1 = 0: V2 = 0: GOSUB 9200
1240 DI = 0: GOSUB 5000
1250 IF TE <> 0 THEN AP = 0: EV$ = "TFTP_DN": RS$ = "FAIL": V1 = TE: V2 = TS: GOSUB 9200: GOTO 1290
1260 EV$ = "TFTP_DN": RS$ = "OK": V1 = 0: V2 = 0: GOSUB 9200
1270 GOSUB 4000: C2 = CS: IF C2 <> C1 THEN AP = 0
1280 EV$ = "CHK_B": RS$ = "OK": IF C2 <> C1 THEN RS$ = "MISMATCH": V1 = C1: V2 = C2: GOSUB 9200
1290 NEXT U
1300 IF AP = 0 THEN EV$ = "CYCLE_END": RS$ = "FAIL": V1 = 0: V2 = 0: GOSUB 9200: RETURN
1310 EV$ = "CYCLE_END": RS$ = "PASS": V1 = 0: V2 = 0: GOSUB 9200
1320 FOR U = 1 TO UC
1330 GOSUB 1500: US$ = MID$(STR$(U),2): VN$ = "VAL" + US$: GOSUB 2000
1340 EV$ = "REFORMAT": RS$ = "OK": IF RE <> 0 THEN RS$ = "FAIL"
1350 V1 = RE: V2 = ME: GOSUB 9200
1360 NEXT U
1370 RETURN

1500 REM ----- GET UNIT STATUS U -> BC -----
1510 GOSUB 300: POKE PX,U: QC = 18: GOSUB 400
1520 LO = PEEK(PX): MI = PEEK(PX): HI = PEEK(PX)
1530 BC = LO + 256 * MI + 65536 * HI
1540 RETURN

2000 REM ----- FORMAT UNIT U TO BC BLOCKS NAME VN$ -----
2010 GOSUB 300: POKE PX,U
2020 BN = BC: GOSUB 600: POKE PX,LO: POKE PX,MI: POKE PX,HI
2030 POKE PX,113
2040 FOR I = 1 TO LEN(VN$): POKE PX,ASC(MID$(VN$,I,1)): NEXT I
2050 POKE PX,0
2060 QC = 29: GOSUB 400
2070 RE = PEEK(PX): ME = PEEK(CR) AND 31
2080 RETURN

3000 REM ----- FILE WORKLOAD ON /VN$ -----
3010 FE = 0
3020 PRINT D$;"PREFIX /";VN$
3030 PRINT D$;"OPEN A.TXT,T,W": PRINT D$;"WRITE A.TXT"
3040 FOR I = 1 TO 120: PRINT # 1,"A,";CY;",";U;",";I: NEXT I
3050 PRINT D$;"CLOSE"
3060 PRINT D$;"OPEN B.TXT,T,W": PRINT D$;"WRITE B.TXT"
3070 FOR I = 1 TO 180: PRINT # 1,"B0,";CY;",";U;",";I: NEXT I
3080 PRINT D$;"CLOSE"
3090 PRINT D$;"OPEN C.TXT,T,W": PRINT D$;"WRITE C.TXT"
3100 FOR I = 1 TO 120: PRINT # 1,"C,";CY;",";U;",";I: NEXT I
3110 PRINT D$;"CLOSE"
3120 PRINT D$;"OPEN B.TXT,T,A": PRINT D$;"WRITE B.TXT"
3130 FOR I = 1 TO 120: PRINT # 1,"B1,";CY;",";U;",";I: NEXT I
3140 PRINT D$;"CLOSE"
3150 PRINT D$;"DELETE C.TXT"
3160 ONERR GOTO 3300
3170 PRINT D$;"OPEN FILL.TXT,T,W": PRINT D$;"WRITE FILL.TXT"
3180 FOR I = 1 TO 40000: PRINT # 1,"F,";CY;",";U;",";I: NEXT I
3190 PRINT D$;"CLOSE"
3200 ONERR GOTO 0
3210 RETURN
3300 FE = PEEK(222)
3310 PRINT D$;"CLOSE"
3320 RESUME 3200

4000 REM ----- CHECKSUM WHOLE VOLUME U -> CS -----
4010 CS = 0
4020 FOR BN = 0 TO BC - 1
4030 GOSUB 4300
4040 IF RE <> 0 THEN BN = BC - 1: GOTO 4090
4050 FOR J = 1 TO 512: V = PEEK(D1): GOSUB 200: NEXT J
4060 NEXT BN
4090 RETURN

4300 REM ----- READBLOCK U,BN -----
4310 GOSUB 300: POKE PX,U
4320 GOSUB 600: POKE PX,LO: POKE PX,MI: POKE PX,HI
4330 QC = 21: GOSUB 400
4340 MS = PEEK(CR) AND 31: RE = PEEK(PX)
4350 IF MS <> 0 THEN RE = MS
4360 RETURN

5000 REM ----- TFTP RUN (DI 0=DN 1=UP) FOR U/FN$ -----
5010 GOSUB 300
5020 FOR I = 1 TO LEN(HK$): POKE D1,ASC(MID$(HK$,I,1)): NEXT I
5030 POKE D1,0
5040 FOR I = 1 TO LEN(FN$): POKE D1,ASC(MID$(FN$,I,1)): NEXT I
5050 POKE D1,0
5060 POKE PX,U: POKE PX,DI: POKE PX,0: POKE PX,113
5070 QC = 80: GOSUB 400
5080 IF (PEEK(CR) AND 31) <> 0 THEN TE = 200 + (PEEK(CR) AND 31): TS = 0: RETURN
5090 TE = 99: TS = 0
5100 FOR TT = 1 TO 3600
5110 GOSUB 5200
5120 IF CF = 1 THEN TE = 0: RETURN
5130 IF CF = 255 THEN TE = 100 + ET: RETURN
5140 FOR Z = 1 TO 150: NEXT Z
5150 NEXT TT
5160 TE = 98: RETURN

5200 REM ----- POLL TFTP STATUS -> CF,TS,ET -----
5210 GOSUB 300
5220 POKE PX,0: POKE PX,0: POKE PX,100
5230 QC = 81: GOSUB 400
5240 CF = PEEK(PX): PB = PEEK(PX): TS = PEEK(PX): ET = PEEK(PX)
5250 RETURN

9000 REM ----- INIT CSV LOG -----
9010 PRINT D$;"DELETE ";LG$
9020 PRINT D$;"OPEN ";LG$;",T,W": PRINT D$;"WRITE ";LG$
9030 PRINT # 1,"cycle,unit,event,result,v1,v2"
9040 PRINT D$;"CLOSE"
9050 RETURN

9200 REM ----- APPEND CSV ROW -----
9210 PRINT D$;"OPEN ";LG$;",T,A": PRINT D$;"WRITE ";LG$
9220 PRINT # 1,CY;",";U;",";EV$;",";RS$;",";V1;",";V2
9230 PRINT D$;"CLOSE"
9240 RETURN

9500 REM ----- LOG WITH UNIT=0 -----
9510 U = 0: RETURN

9600 REM ----- LOG WITH CURRENT UNIT -----
9610 RETURN
