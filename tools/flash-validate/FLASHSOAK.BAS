5 REM FLASHSOAK - overnight soak; log = ProDOS TEXT file, comma-separated rows
6 REM WARNING: destructive test; formats and rewrites writable volumes
7 REM Q1=skip log Q2=log init done (not LGSKIP/LGINIT: Applesoft = first 2 chars only, both "LG")
10 HOME : PRINT "MEGAFLASH FLASHSOAK"
20 INPUT "SLOT (1-7, default 4)";SL: IF SL < 1 THEN SL = 4
30 IF SL > 7 THEN SL = 4
40 CR = 49280 + 16 * SL: PX = CR + 1: D1 = CR + 2
50 D$ = CHR$(4): HK$ = "192.168.0.10"
51 B$ = "": FOR I = 1 TO 40: B$ = B$ + " ": NEXT I
60 INPUT "LOG (DFLT SOAK.TXT, NONE=OFF)";LG$
61 IF LG$ = "NONE" OR LG$ = "none" THEN Q1 = 1: Q2 = 1: GOTO 65
62 IF LG$ = "" THEN LG$ = "SOAK.TXT"
63 Q1 = 0: Q2 = 0
65 PRINT "LOG = TEXT SEQ FILE, CSV-FORMAT LINES"
70 PRINT "SLOT ";SL;" BASE ";CR
80 PRINT "SERVER ";HK$
82 IF Q1 = 1 THEN PRINT "LOG FILE OFF": GOTO 88
84 PRINT "LOG CREATES ON CYCLE 1 (SEE PROGRESS LINE)"
88 REM
90 CY = 1
100 PRINT "PROGRESS = LINE 21 (UPDATES). CTRL-RESET=STOP"
105 VTAB 20: PRINT "----------------------------------------"
110 GOSUB 1000
120 CY = CY + 1
130 GOTO 110

200 REM ----- CS += V (16-bit) -----
210 CS = CS + V: IF CS >= 65536 THEN CS = CS - 65536
220 RETURN

300 REM ----- CMD 0 RESET POINTERS -----
310 POKE CR,0: GOSUB 500
320 RETURN

400 REM ----- EXEC QC -----
410 POKE CR,QC: GOSUB 500
420 RETURN

500 REM ----- WAIT NOT BUSY -----
510 IF PEEK(CR) > 127 THEN 510
520 RETURN

600 REM ----- BN -> LO,MI,HI -----
610 LO = BN - INT(BN / 256) * 256
620 MI = INT(BN / 256) - INT(BN / 65536) * 256
630 HI = INT(BN / 65536)
640 RETURN

1000 REM ===== ONE CYCLE =====
1005 IF Q1 = 0 AND Q2 = 0 THEN GOSUB 9000: Q2 = 1
1010 AU = 1
1020 GOSUB 1450
1023 IF UC < 1 THEN PRINT "NO UNITS (CHECK MEGAFLASH)": END
1024 IF UC > 16 THEN UC = 16
1030 GOSUB 9500: EV$ = "CYCLE_START": RS$ = "OK": V1 = UC: V2 = 0: GOSUB 9200
1035 M$ = "CY" + MID$(STR$(CY),2) + " START " + MID$(STR$(UC),2) + " UNITS": GOSUB 8600
1040 AP = 1
1050 FOR U = 1 TO UC
1060 GOSUB 1500
1070 IF BC < 32 THEN M$ = "U" + MID$(STR$(U),2) + " SKIP SMALL": GOSUB 8600: GOSUB 9600: EV$ = "UNIT_SKIP": RS$ = "SMALL": V1 = BC: V2 = 0: GOSUB 9200: GOTO 1290
1080 US$ = MID$(STR$(U),2): VN$ = "VAL" + US$: FN$ = "validation" + US$ + ".po"
1090 GOSUB 9600: EV$ = "UNIT_START": RS$ = "OK": V1 = BC: V2 = 0: GOSUB 9200
1095 M$ = "CY" + MID$(STR$(CY),2) + " U" + US$ + " " + MID$(STR$(BC),2) + "BLK": GOSUB 8600
1100 GOSUB 2000
1110 IF RE <> 0 THEN AP = 0: M$ = "FORMAT A FAIL": GOSUB 8600: EV$ = "FORMAT_A": RS$ = "FAIL": V1 = RE: V2 = ME: GOSUB 9200: GOTO 1290
1120 EV$ = "FORMAT_A": RS$ = "OK": V1 = 0: V2 = 0: GOSUB 9200
1125 M$ = "FORMAT A OK " + VN$: GOSUB 8600
1130 GOSUB 3000
1140 IF FE <> 0 THEN AP = 0: M$ = "FILES FAIL": GOSUB 8600: EV$ = "FILES": RS$ = "FAIL": V1 = FE: V2 = 0: GOSUB 9200: GOTO 1290
1150 EV$ = "FILES": RS$ = "OK": V1 = 0: V2 = 0: GOSUB 9200
1155 M$ = "FILES OK U" + US$: GOSUB 8600
1160 GOSUB 4000: C1 = CS
1170 EV$ = "CHK_A": RS$ = "OK": V1 = C1: V2 = 0: GOSUB 9200
1175 M$ = "CHK_A=" + MID$(STR$(C1),2): GOSUB 8600
1180 DI = 1: M$ = "TFTP UP " + FN$: GOSUB 8600: GOSUB 5000
1190 IF TE <> 0 THEN AP = 0: M$ = "TFTP UP FAIL": GOSUB 8600: EV$ = "TFTP_UP": RS$ = "FAIL": V1 = TE: V2 = TS: GOSUB 9200: GOTO 1290
1200 EV$ = "TFTP_UP": RS$ = "OK": V1 = 0: V2 = 0: GOSUB 9200
1205 M$ = "TFTP UP OK": GOSUB 8600
1210 GOSUB 2000
1220 IF RE <> 0 THEN AP = 0: M$ = "FORMAT B FAIL": GOSUB 8600: EV$ = "FORMAT_B": RS$ = "FAIL": V1 = RE: V2 = ME: GOSUB 9200: GOTO 1290
1230 EV$ = "FORMAT_B": RS$ = "OK": V1 = 0: V2 = 0: GOSUB 9200
1235 M$ = "FORMAT B OK " + VN$: GOSUB 8600
1240 DI = 0: M$ = "TFTP DN " + FN$: GOSUB 8600: GOSUB 5000
1250 IF TE <> 0 THEN AP = 0: M$ = "TFTP DN FAIL": GOSUB 8600: EV$ = "TFTP_DN": RS$ = "FAIL": V1 = TE: V2 = TS: GOSUB 9200: GOTO 1290
1260 EV$ = "TFTP_DN": RS$ = "OK": V1 = 0: V2 = 0: GOSUB 9200
1265 M$ = "TFTP DN OK": GOSUB 8600
1270 GOSUB 4000: C2 = CS: IF C2 <> C1 THEN AP = 0
1280 EV$ = "CHK_B": RS$ = "OK": IF C2 <> C1 THEN RS$ = "MISMATCH": V1 = C1: V2 = C2
1282 IF C2 <> C1 THEN M$ = "CHK MISMATCH": GOSUB 8600
1284 GOSUB 9200
1285 M$ = "CHK_B=" + MID$(STR$(C2),2): GOSUB 8600
1290 NEXT U
1300 IF AP = 0 THEN M$ = "CY" + MID$(STR$(CY),2) + " END FAIL": GOSUB 8600: EV$ = "CYCLE_END": RS$ = "FAIL": V1 = 0: V2 = 0: GOSUB 9200: RETURN
1310 M$ = "CY" + MID$(STR$(CY),2) + " END PASS": GOSUB 8600: EV$ = "CYCLE_END": RS$ = "PASS": V1 = 0: V2 = 0: GOSUB 9200
1320 M$ = "REFORMAT ALL UNITS": GOSUB 8600
1325 FOR U = 1 TO UC
1330 GOSUB 1500: US$ = MID$(STR$(U),2): VN$ = "VAL" + US$: GOSUB 2000
1335 M$ = "REFMT U" + US$: GOSUB 8600
1340 EV$ = "REFORMAT": RS$ = "OK": IF RE <> 0 THEN RS$ = "FAIL"
1342 IF RE <> 0 THEN M$ = "REFMT FAIL U" + US$: GOSUB 8600
1350 V1 = RE: V2 = ME: GOSUB 9200
1360 NEXT U
1370 RETURN

1450 REM ----- GET DEVICE STATUS -> UC (unit count CMD $11) -----
1460 GOSUB 300: QC = 17: GOSUB 400
1470 UC = PEEK(PX)
1480 RETURN

1500 REM ----- GET UNIT STATUS U -> BC -----
1510 GOSUB 300: POKE PX,U: QC = 18: GOSUB 400
1520 LO = PEEK(PX): MI = PEEK(PX): HI = PEEK(PX)
1530 BC = LO + 256 * MI + 65536 * HI
1540 RETURN

2000 REM ----- FORMAT UNIT U TO BC BLOCKS NAME VN$ -----
2010 GOSUB 300: POKE PX,U
2020 BN = BC: GOSUB 600: POKE PX,LO: POKE PX,MI: POKE PX,HI
2030 POKE PX,113
2040 FOR I = 1 TO LEN(VN$): POKE PX,ASC(MID$(VN$,I,1)): NEXT I
2050 POKE PX,0
2060 QC = 29: GOSUB 400
2070 RE = PEEK(PX): ME = PEEK(CR) AND 31
2080 RETURN

3000 REM ----- FILE WORKLOAD ON /VN$ -----
3010 FE = 0
3015 M$ = "FILES U" + US$ + " VOL/" + VN$: GOSUB 8600
3020 PRINT D$;"PR"+"EFIX";" /";VN$
3030 PRINT D$;"O"+"PEN";" A.TXT,T,W": PRINT D$;"WR"+"ITE";" A.TXT"
3040 FOR I = 1 TO 120: PRINT # 1,"A,";CY;",";U;",";I: NEXT I
3050 PRINT D$;"CL"+"OSE"
3060 PRINT D$;"O"+"PEN";" B.TXT,T,W": PRINT D$;"WR"+"ITE";" B.TXT"
3070 FOR I = 1 TO 180: PRINT # 1,"B0,";CY;",";U;",";I: NEXT I
3080 PRINT D$;"CL"+"OSE"
3090 PRINT D$;"O"+"PEN";" C.TXT,T,W": PRINT D$;"WR"+"ITE";" C.TXT"
3100 FOR I = 1 TO 120: PRINT # 1,"C,";CY;",";U;",";I: NEXT I
3110 PRINT D$;"CL"+"OSE"
3120 PRINT D$;"O"+"PEN";" B.TXT,T,A": PRINT D$;"WR"+"ITE";" B.TXT"
3130 FOR I = 1 TO 120: PRINT # 1,"B1,";CY;",";U;",";I: NEXT I
3140 PRINT D$;"CL"+"OSE"
3150 PRINT D$;"DE"+"LETE";" C.TXT"
3160 ONERR GOTO 3300
3170 PRINT D$;"O"+"PEN";" FILL.TXT,T,W": PRINT D$;"WR"+"ITE";" FILL.TXT"
3175 M$ = "FILE FILL (LONG)": GOSUB 8600
3180 FOR I = 1 TO 40000: PRINT # 1,"F,";CY;",";U;",";I: NEXT I
3190 PRINT D$;"CL"+"OSE"
3200 ONERR GOTO 0
3210 RETURN
3300 FE = PEEK(222)
3310 PRINT D$;"CL"+"OSE"
3320 RESUME 3200

4000 REM ----- CHECKSUM WHOLE VOLUME U -> CS -----
4010 CS = 0
4015 M$ = "CHK READING...": GOSUB 8600
4020 FOR BN = 0 TO BC - 1
4030 GOSUB 4300
4040 IF RE <> 0 THEN BN = BC - 1: GOTO 4090
4045 IF BN = 0 THEN 4050
4046 IF BN - 256 * INT(BN / 256) <> 0 THEN 4050
4047 M$ = "CHK BLK " + MID$(STR$(BN),2) + "/" + MID$(STR$(BC),2): GOSUB 8600
4050 FOR J = 1 TO 512: V = PEEK(D1): GOSUB 200: NEXT J
4060 NEXT BN
4090 RETURN

4300 REM ----- READBLOCK U,BN -----
4310 GOSUB 300: POKE PX,U
4320 GOSUB 600: POKE PX,LO: POKE PX,MI: POKE PX,HI
4330 QC = 21: GOSUB 400
4340 MS = PEEK(CR) AND 31: RE = PEEK(PX)
4350 IF MS <> 0 THEN RE = MS
4360 RETURN

5000 REM ----- TFTP RUN (DI 0=DN 1=UP) FOR U/FN$ -----
5010 GOSUB 300
5020 FOR I = 1 TO LEN(HK$): POKE D1,ASC(MID$(HK$,I,1)): NEXT I
5030 POKE D1,0
5040 FOR I = 1 TO LEN(FN$): POKE D1,ASC(MID$(FN$,I,1)): NEXT I
5050 POKE D1,0
5060 POKE PX,U: POKE PX,DI: POKE PX,0: POKE PX,113
5070 QC = 80: GOSUB 400
5080 IF (PEEK(CR) AND 31) <> 0 THEN TE = 200 + (PEEK(CR) AND 31): TS = 0: RETURN
5090 TE = 99: TS = 0
5100 FOR TT = 1 TO 3600
5110 GOSUB 5200
5112 IF TT - 50 * INT(TT / 50) <> 0 THEN 5120
5114 M$ = "TFTP WAIT " + MID$(STR$(TT),2): GOSUB 8600
5120 IF CF = 1 THEN TE = 0: RETURN
5130 IF CF = 255 THEN TE = 100 + ET: RETURN
5140 FOR Z = 1 TO 150: NEXT Z
5150 NEXT TT
5160 TE = 98: RETURN

5200 REM ----- POLL TFTP STATUS -> CF,TS,ET -----
5210 GOSUB 300
5220 POKE PX,0: POKE PX,0: POKE PX,100
5230 QC = 81: GOSUB 400
5240 CF = PEEK(PX): PB = PEEK(PX): TS = PEEK(PX): ET = PEEK(PX)
5250 RETURN

8600 REM ----- STATUS LINE (VTAB 21, 40 cols, pad clear) -----
8610 VTAB 21: HTAB 1: PRINT LEFT$(M$ + B$,40)
8620 RETURN

8700 REM ----- TS$ = 8-char time (ProDOS TIME$; avoids CMD $19 hang) -----
8750 TS$ = TIME$
8760 IF LEN(TS$) > 8 THEN TS$ = LEFT$(TS$,8)
8770 IF LEN(TS$) < 8 THEN FOR I = LEN(TS$) + 1 TO 8: TS$ = TS$ + " ": NEXT I
8780 RETURN

9000 REM ----- LOG NEW RUN START (append only; never delete log) -----
9010 CY = 0: U = 0: EV$ = "RUN_START": RS$ = "OK": V1 = 0: V2 = 0
9015 M$ = "OPENING " + LG$: GOSUB 8600
9020 GOSUB 9200
9030 RETURN

9200 REM ----- APPEND TEXT ROW (ts,cycle,unit,event,result,v1,v2) -----
9202 IF Q1 = 1 THEN RETURN
9205 GOSUB 8750
9208 REM If OPEN hangs: bad PREFIX/volume; try /RAM/SOAK.TXT or NONE
9210 ONERR GOTO 9250
9215 PRINT D$;"O"+"PEN";LG$;",T,A": PRINT D$;"WR"+"ITE";LG$
9220 PRINT # 1,TS$;",";CY;",";U;",";EV$;",";RS$;",";V1;",";V2
9230 PRINT D$;"CL"+"OSE"
9240 RETURN
9250 REM ----- create log if missing: header + same row -----
9255 ONERR GOTO 0
9260 PRINT D$;"O"+"PEN";LG$;",T,W": PRINT D$;"WR"+"ITE";LG$
9270 PRINT # 1,"ts,cycle,unit,event,result,v1,v2"
9280 PRINT # 1,TS$;",";CY;",";U;",";EV$;",";RS$;",";V1;",";V2
9290 PRINT D$;"CL"+"OSE"
9300 RETURN

9500 REM ----- LOG WITH UNIT=0 -----
9510 U = 0: RETURN

9600 REM ----- LOG WITH CURRENT UNIT -----
9610 RETURN
