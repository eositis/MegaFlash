5 REM FLASHVAL - MegaFlash flash-path validator (Applesoft)
6 REM Non-destructive path C0C0-C0C3 (see README.md)
7 REM CR = 49280 + 16*SLOT (slot 4 -> 49344 decimal)
10 HOME : PRINT "MEGAFLASH FLASHVAL"
20 INPUT "SLOT (1-7, default 4)";SL: IF SL < 1 THEN SL = 4
30 IF SL > 7 THEN SL = 4
40 CR = 49280 + 16 * SL: PX = CR + 1: D1 = CR + 2
50 PRINT "SLOT ";SL;" BASE ";CR
60 INPUT "MODE 1=SCREEN 2=SAVE 3=COMPARE";MD
70 D$ = CHR$(4)
80 ON MD GOSUB 1000,2000,3000: END

100 REM ----- CS += V (16-bit) -----
110 CS = CS + V: IF CS >= 65536 THEN CS = CS - 65536
120 RETURN

200 REM ----- WAIT NOT BUSY -----
210 IF PEEK(CR) > 127 THEN 210
220 RETURN

300 REM ----- CMD 0 RESET POINTERS -----
310 POKE CR,0: GOSUB 200
320 RETURN

400 REM ----- EXEC QC -----
410 POKE CR,QC: GOSUB 200
420 RETURN

500 REM ----- SUM N PARAM BYTES INTO CS -----
510 FOR I = 1 TO N: V = PEEK(PX): GOSUB 100: NEXT I
520 RETURN

600 REM ----- SUM 512 DATA BYTES INTO DS -----
610 FOR I = 1 TO 512: V = PEEK(D1): DS = DS + V: IF DS >= 65536 THEN DS = DS - 65536
620 NEXT I
630 RETURN

700 REM ----- 24-BIT BLOCK BYTES -> LO,MID,HI -----
710 LO = BN - INT(BN / 256) * 256
720 MID = INT(BN / 256) - INT(BN / 65536) * 256
730 HI = INT(BN / 65536)
740 RETURN

800 REM ----- READBLOCK UN,BN -> ST,PE,DC -----
810 GOSUB 300: POKE PX,UN: GOSUB 700: POKE PX,LO: POKE PX,MID: POKE PX,HI
820 QC = 21: GOSUB 400: ST = PEEK(CR): PE = PEEK(PX): DS = 0: GOSUB 600: DC = DS
830 RETURN

1000 REM ===== MODE 1: SCREEN =====
1010 GOSUB 4000: PRINT "--- DONE ---": RETURN

2000 REM ===== MODE 2: SAVE BASELINE (PRODOS) =====
2010 INPUT "FILENAME";F$
2020 PRINT D$;"O"+"PEN";F$;",T,W": PRINT D$;"WR"+"ITE";F$
2030 GOSUB 4500
2040 PRINT D$;"CL"+"OSE": PRINT "WROTE ";F$: RETURN

3000 REM ===== MODE 3: DIFF BASELINE =====
3010 INPUT "FILENAME";F$
3020 PRINT D$;"O"+"PEN";F$;",T,R": PRINT D$;"RE"+"AD";F$
3030 INPUT # 1,H$: IF H$ <> "FLASHVAL1" THEN PRINT "BAD HEADER": GOTO 3090
3040 INPUT # 1,SL2: IF SL2 <> SL THEN PRINT "SLOT MISMATCH": GOTO 3090
3050 GOSUB 4000: REM compute T1..T12
3060 GOSUB 5000: REM compare rest of file
3090 PRINT D$;"CL"+"OSE": RETURN

4000 REM ===== RUN SUITE -> T1..T12 + PRINT =====
4010 QC = 3: GOSUB 300: GOSUB 400: REM LINEAR
4020 GOSUB 300: QC = 16: GOSUB 400: CS = 0: N = 12: GOSUB 500: T1 = CS: PRINT "DEVINFO12 ";CS
4030 GOSUB 300: QC = 16: GOSUB 400: CS = 0: FOR I = 1 TO 3: V = PEEK(PX): NEXT
4040 V = PEEK(PX): GOSUB 100: V = PEEK(PX): GOSUB 100: T2 = CS: PRINT "FWVER ";CS
4050 GOSUB 300: QC = 17: GOSUB 400: T3 = PEEK(PX): PRINT "DEVSTATUS ";T3
4060 GOSUB 300: POKE PX,1: QC = 18: GOSUB 400: CS = 0: N = 3: GOSUB 500: T4 = CS: PRINT "U1BC ";CS
4070 GOSUB 300: POKE PX,1: QC = 19: GOSUB 400: CS = 0: N = 25: GOSUB 500: T5 = CS: PRINT "DIB25 ";CS
4080 GOSUB 300: POKE PX,1: QC = 20: GOSUB 400: CS = 0: N = 32: GOSUB 500: T6 = CS: PRINT "VOL32 ";CS
4090 UN = 1: BN = 0: GOSUB 800: T7 = ST: T8 = PE: T9 = DC
4100 PRINT "RB1_0_ST ";ST: PRINT "RB1_0_PE ";PE: PRINT "RB1_0_DC ";DC
4110 UN = 1: BN = 1: GOSUB 800: T10 = ST: T11 = PE: T12 = DC
4120 PRINT "RB1_1_ST ";ST: PRINT "RB1_1_PE ";PE: PRINT "RB1_1_DC ";DC
4130 RETURN

4500 REM ===== WRITE BASELINE TO OPEN FILE chan 1 =====
4510 QC = 3: GOSUB 300: GOSUB 400
4520 GOSUB 300: QC = 16: GOSUB 400: CS = 0: N = 12: GOSUB 500: T1 = CS: PRINT # 1,"FLASHVAL1": PRINT # 1,SL: PRINT # 1,"DEVINFO12 ";CS
4530 GOSUB 300: QC = 16: GOSUB 400: CS = 0: FOR I = 1 TO 3: V = PEEK(PX): NEXT
4540 V = PEEK(PX): GOSUB 100: V = PEEK(PX): GOSUB 100: T2 = CS: PRINT # 1,"FWVER ";CS
4550 GOSUB 300: QC = 17: GOSUB 400: T3 = PEEK(PX): PRINT # 1,"DEVSTATUS ";T3
4560 GOSUB 300: POKE PX,1: QC = 18: GOSUB 400: CS = 0: N = 3: GOSUB 500: T4 = CS: PRINT # 1,"U1BC ";CS
4570 GOSUB 300: POKE PX,1: QC = 19: GOSUB 400: CS = 0: N = 25: GOSUB 500: T5 = CS: PRINT # 1,"DIB25 ";CS
4580 GOSUB 300: POKE PX,1: QC = 20: GOSUB 400: CS = 0: N = 32: GOSUB 500: T6 = CS: PRINT # 1,"VOL32 ";CS
4590 UN = 1: BN = 0: GOSUB 800: T7 = ST: T8 = PE: T9 = DC: PRINT # 1,"RB1_0_ST ";ST: PRINT # 1,"RB1_0_PE ";PE: PRINT # 1,"RB1_0_DC ";DC
4600 UN = 1: BN = 1: GOSUB 800: T10 = ST: T11 = PE: T12 = DC: PRINT # 1,"RB1_1_ST ";ST: PRINT # 1,"RB1_1_PE ";PE: PRINT # 1,"RB1_1_DC ";DC
4610 RETURN

5000 REM ===== COMPARE REMAINING LINES =====
5010 INPUT # 1,A$: GOSUB 5500: IF K$ <> "DEVINFO12" OR V <> T1 THEN PRINT "FAIL ";A$: RETURN
5020 INPUT # 1,A$: GOSUB 5500: IF K$ <> "FWVER" OR V <> T2 THEN PRINT "FAIL ";A$: RETURN
5030 INPUT # 1,A$: GOSUB 5500: IF K$ <> "DEVSTATUS" OR V <> T3 THEN PRINT "FAIL ";A$: RETURN
5040 INPUT # 1,A$: GOSUB 5500: IF K$ <> "U1BC" OR V <> T4 THEN PRINT "FAIL ";A$: RETURN
5050 INPUT # 1,A$: GOSUB 5500: IF K$ <> "DIB25" OR V <> T5 THEN PRINT "FAIL ";A$: RETURN
5060 INPUT # 1,A$: GOSUB 5500: IF K$ <> "VOL32" OR V <> T6 THEN PRINT "FAIL ";A$: RETURN
5070 INPUT # 1,A$: GOSUB 5500: IF K$ <> "RB1_0_ST" OR V <> T7 THEN PRINT "FAIL ";A$: RETURN
5080 INPUT # 1,A$: GOSUB 5500: IF K$ <> "RB1_0_PE" OR V <> T8 THEN PRINT "FAIL ";A$: RETURN
5090 INPUT # 1,A$: GOSUB 5500: IF K$ <> "RB1_0_DC" OR V <> T9 THEN PRINT "FAIL ";A$: RETURN
5100 INPUT # 1,A$: GOSUB 5500: IF K$ <> "RB1_1_ST" OR V <> T10 THEN PRINT "FAIL ";A$: RETURN
5110 INPUT # 1,A$: GOSUB 5500: IF K$ <> "RB1_1_PE" OR V <> T11 THEN PRINT "FAIL ";A$: RETURN
5120 INPUT # 1,A$: GOSUB 5500: IF K$ <> "RB1_1_DC" OR V <> T12 THEN PRINT "FAIL ";A$: RETURN
5130 PRINT "ALL MATCH": RETURN

5500 REM ----- PARSE KEY VALUE IN A$ -> K$,V -----
5510 SP = 0: FOR I = 1 TO LEN(A$): IF MID$(A$,I,1) = " " THEN SP = I: I = LEN(A$)
5520 NEXT I
5530 IF SP = 0 THEN K$ = "": V = -1: RETURN
5540 K$ = MID$(A$,1,SP - 1): V = VAL(MID$(A$,SP + 1)): RETURN
