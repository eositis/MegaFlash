5 REM FV screen suite disk build see SRC file for full
6 REM C0 path CR base 49280 plus 16 times slot
10 HOME : PRINT "MEGAFLASH FV"
20 INPUT "SLOT 1-7";SL: IF SL < 1 THEN SL = 4
30 IF SL > 7 THEN SL = 4
40 CR = 49280 + 16 * SL: PX = CR + 1: D1 = CR + 2
50 PRINT "SLOT ";SL;" BASE ";CR
60 PRINT "SRC FILE HAS FULL SOURCE": PRINT
70 GOSUB 4000: PRINT "OK": END

100 REM ----- CS += V (16-bit) -----
110 CS = CS + V: IF CS >= 65536 THEN CS = CS - 65536
120 RETURN

200 REM ----- WAIT NOT BUSY -----
210 IF PEEK(CR) > 127 THEN 210
220 RETURN

300 REM ----- CMD 0 RESET POINTERS -----
310 POKE CR,0: GOSUB 200
320 RETURN

400 REM ----- EXEC QC -----
410 POKE CR,QC: GOSUB 200
420 RETURN

500 REM ----- SUM N PARAM BYTES INTO CS -----
510 FOR I = 1 TO N: V = PEEK(PX): GOSUB 100: NEXT I
520 RETURN

600 REM ----- SUM 512 DATA BYTES INTO DS -----
610 FOR I = 1 TO 512: V = PEEK(D1): DS = DS + V: IF DS >= 65536 THEN DS = DS - 65536
620 NEXT I
630 RETURN

700 REM ----- 24-BIT BLOCK BYTES -> LO,MID,HI -----
710 LO = BN - INT(BN / 256) * 256
720 MID = INT(BN / 256) - INT(BN / 65536) * 256
730 HI = INT(BN / 65536)
740 RETURN

800 REM ----- READBLOCK UN,BN -> ST,PE,DC -----
810 GOSUB 300: POKE PX,UN: GOSUB 700: POKE PX,LO: POKE PX,MID: POKE PX,HI
820 QC = 21: GOSUB 400: ST = PEEK(CR): PE = PEEK(PX): DS = 0: GOSUB 600: DC = DS
830 RETURN

4000 REM ===== RUN SUITE -> PRINT =====
4010 QC = 3: GOSUB 300: GOSUB 400
4020 GOSUB 300: QC = 16: GOSUB 400: CS = 0: N = 12: GOSUB 500: T1 = CS: PRINT "DEVINFO12 ";CS
4030 GOSUB 300: QC = 16: GOSUB 400: CS = 0: FOR I = 1 TO 3: V = PEEK(PX): NEXT
4040 V = PEEK(PX): GOSUB 100: V = PEEK(PX): GOSUB 100: T2 = CS: PRINT "FWVER ";CS
4050 GOSUB 300: QC = 17: GOSUB 400: T3 = PEEK(PX): PRINT "DEVSTATUS ";T3
4060 GOSUB 300: POKE PX,1: QC = 18: GOSUB 400: CS = 0: N = 3: GOSUB 500: T4 = CS: PRINT "U1BC ";CS
4070 GOSUB 300: POKE PX,1: QC = 19: GOSUB 400: CS = 0: N = 25: GOSUB 500: T5 = CS: PRINT "DIB25 ";CS
4080 GOSUB 300: POKE PX,1: QC = 20: GOSUB 400: CS = 0: N = 32: GOSUB 500: T6 = CS: PRINT "VOL32 ";CS
4090 UN = 1: BN = 0: GOSUB 800: T7 = ST: T8 = PE: T9 = DC
4100 PRINT "RB1_0_ST ";ST: PRINT "RB1_0_PE ";PE: PRINT "RB1_0_DC ";DC
4110 UN = 1: BN = 1: GOSUB 800: T10 = ST: T11 = PE: T12 = DC
4120 PRINT "RB1_1_ST ";ST: PRINT "RB1_1_PE ";PE: PRINT "RB1_1_DC ";DC
4130 RETURN
