5 REM TFTPUTIL - MegaFlash TFTP disk image up/down (no Control Panel)
8 PR#3
10 HOME : PRINT "MEGAFLASH TFTP DISK IMAGE"
15 D$ = CHR$(4): HK$ = "192.168.0.10": GOSUB 6500
20 GOSUB 6000
30 IF SL > 0 THEN 40
35 PRINT "MEGAFLASH NOT FOUND (CHECKED SLOTS 1-7).": END
40 CR = 49280 + 16 * SL: PX = CR + 1: D1 = CR + 2
50 INPUT "TFTP HOST FQDN OR IP (RETURN=" + HK$ + ")";T$: IF T$ <> "" THEN HK$ = T$
55 GOSUB 6600
60 GOSUB 7000
70 INPUT "MEGAFLASH UNIT (1.." + MID$(STR$(UC),2) + ")";U
72 IF U < 1 OR U > UC THEN PRINT "USE 1.." + MID$(STR$(UC),2): GOTO 70
80 PRINT "1 = UPLOAD VOLUME TO SERVER"
90 PRINT "2 = DOWNLOAD FROM SERVER TO VOLUME"
100 INPUT "CHOICE (1 OR 2)";CH
110 DI = 0: IF CH = 1 THEN DI = 1
120 IF CH <> 1 AND CH <> 2 THEN PRINT "USE 1 OR 2": GOTO 100
130 INPUT "REMOTE FILE (E.G. IMAGE.PO)";FN$
140 IF LEN(FN$) = 0 THEN PRINT "NEED A FILENAME": GOTO 130
150 PRINT "SLOT ";SL;" UNIT ";U;" ";: IF DI = 1 THEN PRINT "UPLOAD " ELSE PRINT "DOWNLOAD "
160 PRINT "SERVER ";HK$
170 PRINT "FILE ";FN$
180 PRINT "WORKING... (LINE 21 = STATUS)"
190 VTAB 20: PRINT "----------------------------------------"
200 GOSUB 5000
210 IF TE = 0 THEN PRINT "DONE OK.": END
220 PRINT "FAILED. CODE ";TE
230 END

300 REM ----- CMD 0 RESET POINTERS -----
310 POKE CR,0: GOSUB 500
320 RETURN

400 REM ----- EXEC QC -----
410 POKE CR,QC: GOSUB 500
420 RETURN

500 REM ----- WAIT NOT BUSY -----
510 IF PEEK(CR) > 127 THEN 510
520 RETURN

5000 REM ----- TFTP RUN (DI 0=DN 1=UP) FOR U/FN$ / HK$ -----
5010 GOSUB 300
5020 FOR I = 1 TO LEN(HK$): POKE D1,ASC(MID$(HK$,I,1)): NEXT I
5030 POKE D1,0
5040 FOR I = 1 TO LEN(FN$): POKE D1,ASC(MID$(FN$,I,1)): NEXT I
5050 POKE D1,0
5060 POKE PX,U: POKE PX,DI: POKE PX,0: POKE PX,113
5070 QC = 80: GOSUB 400
5080 IF (PEEK(CR) AND 31) <> 0 THEN TE = 200 + (PEEK(CR) AND 31): TS = 0: RETURN
5090 TE = 99: TS = 0
5100 FOR TT = 1 TO 3600
5110 GOSUB 5200
5112 IF TT - 50 * INT(TT / 50) <> 0 THEN 5120
5114 M$ = "TFTP WAIT " + MID$(STR$(TT),2): GOSUB 8600
5120 IF CF = 1 THEN TE = 0: RETURN
5130 IF CF = 255 THEN TE = 100 + ET: RETURN
5140 FOR Z = 1 TO 150: NEXT Z
5150 NEXT TT
5160 TE = 98: RETURN

5200 REM ----- POLL TFTP STATUS -> CF,TS,ET -----
5210 GOSUB 300
5220 POKE PX,0: POKE PX,0: POKE PX,100
5230 QC = 81: GOSUB 400
5240 CF = PEEK(PX): PB = PEEK(PX): TS = PEEK(PX): ET = PEEK(PX)
5250 RETURN

8600 REM ----- STATUS LINE VTAB 21 -----
8610 VTAB 21: HTAB 1: PRINT M$
8620 RETURN

6000 REM ----- AUTODETECT SLOT (PREFER 4) -----
6010 SL = 0
6020 SX = 4: GOSUB 6200: IF PF = 1 THEN SL = 4: PRINT "MEGAFLASH FOUND IN SLOT 4.": RETURN
6030 FOR SX = 1 TO 7
6040 IF SX = 4 THEN 6070
6050 GOSUB 6200: IF PF = 1 THEN SL = SX: PRINT "MEGAFLASH NOT IN SLOT 4; USING SLOT ";SL: RETURN
6070 NEXT SX
6080 RETURN

6200 REM ----- PROBE SLOT SX -> PF -----
6210 PF = 0
6220 TR = 49280 + 16 * SX: TX = TR + 1
6230 FOR WT = 1 TO 300: IF PEEK(TR) <= 127 THEN WT = 300
6240 NEXT WT
6250 IF PEEK(TR) > 127 THEN RETURN
6260 POKE TR,0
6270 FOR WT = 1 TO 300: IF PEEK(TR) <= 127 THEN WT = 300
6280 NEXT WT
6290 IF PEEK(TR) > 127 THEN RETURN
6300 POKE TR,17
6310 FOR WT = 1 TO 300: IF PEEK(TR) <= 127 THEN WT = 300
6320 NEXT WT
6330 ST = PEEK(TR) AND 31: UC = PEEK(TX)
6340 IF ST = 0 AND UC > 0 AND UC < 33 THEN PF = 1
6350 RETURN

6500 REM ----- LOAD DEFAULT HOST FROM TFTPUTIL.CFG -----
6510 ONERR GOTO 6580
6520 PRINT D$;"O"+"PEN";"TFTPUTIL.CFG,T,R": PRINT D$;"RE"+"AD";"TFTPUTIL.CFG"
6530 INPUT # 1,CH$
6540 PRINT D$;"CL"+"OSE"
6550 ONERR GOTO 0
6560 IF LEN(CH$) > 0 THEN HK$ = CH$
6570 RETURN
6580 PRINT D$;"CL"+"OSE"
6590 ONERR GOTO 0
6595 RETURN

6600 REM ----- SAVE DEFAULT HOST TO TFTPUTIL.CFG -----
6610 ONERR GOTO 6680
6620 PRINT D$;"O"+"PEN";"TFTPUTIL.CFG,T,W": PRINT D$;"WR"+"ITE";"TFTPUTIL.CFG"
6630 PRINT # 1,HK$
6640 PRINT D$;"CL"+"OSE"
6650 ONERR GOTO 0
6660 RETURN
6680 PRINT D$;"CL"+"OSE"
6690 ONERR GOTO 0
6695 RETURN

7000 REM ----- LIST AVAILABLE VOLUMES (UNIT + NAME) -----
7010 GOSUB 300: QC = 17: GOSUB 400
7020 UC = PEEK(PX): IF UC < 1 THEN PRINT "NO MEGAFLASH UNITS FOUND.": END
7030 IF UC > 16 THEN UC = 16
7040 PRINT "AVAILABLE VOLUMES:"
7050 FOR UQ = 1 TO UC
7060 GOSUB 7100
7070 PRINT "  ";UQ;" - ";VN$
7080 NEXT UQ
7090 RETURN

7100 REM ----- GET VOLUME NAME FOR UQ -> VN$ -----
7110 VN$ = "(UNKNOWN)"
7120 GOSUB 300: POKE PX,UQ: QC = 20: GOSUB 400
7130 IF (PEEK(CR) AND 31) <> 0 THEN RETURN
7140 B0 = PEEK(PX): NL = B0 - 16 * INT(B0 / 16)
7150 IF NL < 1 OR NL > 15 THEN FOR I = 1 TO 31: X = PEEK(PX): NEXT I: RETURN
7160 VN$ = ""
7170 FOR I = 1 TO NL
7180 X = PEEK(PX)
7190 IF X < 32 OR X > 126 THEN X = 63
7200 VN$ = VN$ + CHR$(X)
7210 NEXT I
7220 FOR I = NL + 1 TO 31: X = PEEK(PX): NEXT I
7230 RETURN
