diff --git a/pico/busloop.h b/pico/busloop.h
index f2abd3b..24351ff 100644
--- a/pico/busloop.h
+++ b/pico/busloop.h
@@ -1,9 +1,49 @@
 #ifndef _BUSLOOP_H
 #define _BUSLOOP_H
 
+#include <stdint.h>
+
+#ifndef MF_BUS_DIAG
+#define MF_BUS_DIAG 0
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
 
 void BusLoopDataInit();
 void BusLoop();
 
+#if MF_BUS_DIAG
+/*
+ * §1cy bus-path diagnostics. Build with -DMF_BUS_DIAG=1 on a **Release** configuration: the Debug
+ * build flushes up to 48 [u2m] lines per core-0 iteration through a blocking 115200-baud printf,
+ * which starves NetworkPump_PollOnce and by itself breaks TCP connects — so Debug cannot measure
+ * either bus timing or connection behaviour.
+ *
+ * The a2bus SM answers a 6502 read entirely from `rxf_putget`, latching chunk 1 about 140 ns after
+ * nDEVSEL falls, while a2buslistener pushes the cycle record about 70 ns after nDEVSEL. So if the
+ * listener FIFO is still non-empty once core 1 has already pushed the next prefetch byte, the
+ * queued cycle was necessarily answered from the *previous* chunk-1 value: the 6502 got a
+ * duplicate byte and the remainder of the frame is shifted. `behind` is therefore a direct count
+ * of corrupted DATA bytes, not a proxy. In healthy operation it must be 0 — even the tightest
+ * 6502 sequence (back-to-back `eor $C0C7`, the §1d RTR probe) leaves ~4 us between accesses.
+ *
+ * Sampling happens AFTER UpdateMegaFlashRegisters so the measurement cannot itself delay the
+ * prefetch it is measuring. RXSTALL is a sticky write-1-to-clear flag, so it is read and cleared
+ * on core 0 in BusDiagReport() and costs the bus path nothing.
+ */
+extern volatile uint32_t g_bus_c0c7_reads;      /* total $C0C7 read cycles serviced */
+extern volatile uint32_t g_bus_behind;          /* $C0C7 reads with a cycle still queued behind */
+extern volatile uint32_t g_bus_fifo_high_water; /* max listener FIFO level observed */
+extern volatile uint32_t g_bus_rxstall;         /* listener `push noblock` discarded a cycle */
+
+/** Print counters and clear the sticky PIO RXSTALL flag. Core 0 only (uses stdio). */
+void BusDiagReport(void);
+#endif
+
+#ifdef __cplusplus
+}
+#endif
 
 #endif
