-       * PIO prefetch word is not delayed in the ip65 mov_data burst (checksums / RX_RD walk). */
-      if (!(addr == U2_C0X_LAST && (busdata & READFLAG))) {
-        if (++u2_poll_counter >= 32) {
-          u2_poll_counter = 0;
-          U2_Poll();
+#if MF_BUS_DIAG
+      /* Sampled only AFTER the prefetch is published, so it cannot delay what it measures.
+       * A cycle still queued here was already answered from the previous chunk-1 value (§1cy). */
+      if (addr == U2_C0X_LAST && (busdata & READFLAG)) {
+        uint32_t lvl = pio_sm_get_rx_fifo_level(pio0, SM_LISTENER);
+        g_bus_c0c7_reads++;
+        if (lvl) {
+          g_bus_behind++;
+          if (lvl > g_bus_fifo_high_water)
+            g_bus_fifo_high_water = lvl;
         }
       }
+      /* Harvested per cycle, not per report: RXSTALL is sticky, so sampling it only in the 10 s
+       * BusDiagReport() could add at most 1 per window and could not distinguish one dropped
+       * cycle from millions (§1db). Still after the prefetch publish, so it costs no deadline. */
+      {
+        const uint32_t stall_bit = 1u << (PIO_FDEBUG_RXSTALL_LSB + SM_LISTENER);
+        if (pio0->fdebug & stall_bit) {
